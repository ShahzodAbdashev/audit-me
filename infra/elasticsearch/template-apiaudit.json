            "type": {
              "type": "keyword",
              "ignore_above": 256
            },
            "message": {
              "type": "text",
              "norms": false
            }
          }
        },
        "audit": {
          "dynamic": false,
          "properties": {
            "route": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "path_params": {
              "type": "flattened",
              "depth_limit": 25,
              "ignore_above": 1024
            },
            "request": {
              "dynamic": false,
              "properties": {
                "headers": {
                  "type": "flattened",
                  "depth_limit": 25,
                  "ignore_above": 1024
                },
                "query": {
                  "type": "flattened",
                  "depth_limit": 25,
                  "ignore_above": 1024
                },
                "body": {
                  "type": "flattened",
                  "depth_limit": 25,
                  "ignore_above": 1024
                },
                "body_raw": {
                  "type": "keyword",
                  "index": false,
                  "doc_values": false
                },
                "body_bytes": {
                  "type": "long"
                },
                "body_truncated": {
                  "type": "boolean"
                },
                "body_parse_failed": {
                  "type": "boolean"
                },
                "body_skipped": {
                  "type": "keyword",
                  "ignore_above": 32
                },
                "multipart": {
                  "type": "flattened",
                  "depth_limit": 25,
                  "ignore_above": 1024
                },
                "query_skipped": {
                  "type": "keyword",
                  "ignore_above": 32
                }
              }
            },
            "response": {
              "dynamic": false,
              "properties": {
                "headers": {
                  "type": "flattened",
