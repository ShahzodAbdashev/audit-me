            "query": {
              "dynamic": false,
              "properties": {
                "normalized": {
                  "type": "nested",
                  "dynamic": false,
                  "properties": {
                    "field": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "label": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "operator": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "value": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "logic": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "group": {
                      "type": "integer"
                    }
                  }
                },
                "text": {
                  "type": "text"
                },
                "datasource": {
                  "type": "keyword",
                  "ignore_above": 256
