              "ignore_above": 256
            },
            "category": {
              "type": "keyword",
              "ignore_above": 256
            },
            "risk": {
              "type": "keyword",
              "ignore_above": 256
            },
            "sensitivity": {
              "type": "keyword",
              "ignore_above": 256
            },
            "derived": {
              "type": "boolean"
            },
            "level": {
              "type": "keyword",
              "ignore_above": 256
            },
            "result": {
              "type": "keyword",
              "ignore_above": 256
            },
            "description": {
              "type": "text"
            },
            "count": {
              "type": "long"
            },
            "target": {
              "dynamic": false,
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "id": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "label": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 512
                    }
                  }
                },
                "pinpp": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "msisdn": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "passport": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "imei": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "changes": {
              "dynamic": false,
              "properties": {
                "diff": {
                  "type": "nested",
                  "dynamic": false,
                  "properties": {
                    "field": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "label": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "old": {
                      "type": "keyword",
                      "ignore_above": 256
                    },
                    "new": {
                      "type": "keyword",
                      "ignore_above": 256
                    }
                  }
                },
                "before": {
                  "type": "object",
                  "dynamic": false,
                  "enabled": false
                },
                "after": {
                  "type": "object",
                  "dynamic": false,
                  "enabled": false
                }
              }
            },
            "detail": {
              "type": "object",
              "dynamic": false,
              "enabled": false
            },
            "i18n": {
              "dynamic": false,
              "properties": {
                "key": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "params": {
                  "type": "object",
                  "dynamic": false,
                  "enabled": false
                }
              }
            },
            "session": {
              "dynamic": false,
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "client": {
              "dynamic": false,
              "properties": {
                "ip_source": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "forwarded_chain": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
